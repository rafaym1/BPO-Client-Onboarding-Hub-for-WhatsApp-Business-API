# ---------------------------------------------------------------------------
# BPO Onboarding Hub - copy to .env  (cp .env.example .env)
# Everything below is OPTIONAL to get the demo running: with credentials left
# blank, WhatsApp, HubSpot and Jira run in MOCK mode (see README).
# (Comments are on their own lines on purpose: some env-file parsers treat
#  trailing "# ..." as part of the value.)
# ---------------------------------------------------------------------------

# --- WhatsApp Cloud API (Graph v20.0) --------------------------------------
# Meta for Developers -> your app -> WhatsApp -> API Setup.
# Access token (temporary or System User). Blank => mock WhatsApp.
WHATSAPP_TOKEN=
# App settings -> Basic -> App secret. Validates X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into Meta's webhook config.
VERIFY_TOKEN=bpo-verify-token
# The test number's "Phone number ID". Used when a client leaves it blank.
PHONE_NUMBER_ID=
# WhatsApp Business Account ID. Needed for template submission.
WABA_ID=

# --- HubSpot CRM API v3 -----------------------------------------------------
# Private app token (contacts, deals, notes, tasks - read/write). Blank => mock.
HUBSPOT_TOKEN=
# Optional custom boolean contact property that stores WhatsApp opt-in, e.g. whatsapp_opt_in
HUBSPOT_OPTIN_PROPERTY=

# --- Jira Cloud API v3 ------------------------------------------------------
# Atlassian account email. Blank => mock Jira.
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# e.g. yourcompany.atlassian.net
JIRA_DOMAIN=
JIRA_PROJECT_KEY=BPO
# Issue type used for the 7 onboarding steps under the Epic.
JIRA_TASK_ISSUE_TYPE=Task

# --- Force a mock mode regardless of credentials: true | false | auto -------
MOCK_WHATSAPP=auto
MOCK_HUBSPOT=auto
MOCK_JIRA=auto
# How long the mocked Meta template review takes (seconds).
MOCK_TEMPLATE_REVIEW_SECONDS=5

# --- Infrastructure (docker-compose overrides DATABASE_URL / REDIS_URL) ------
DATABASE_URL=postgresql://bpo:bpo@localhost:5432/bpo
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
# Enables /api/dev/* simulators and the demo helper buttons in the UI.
DEV_TOOLS=true
CLINIC_TIMEZONE=Europe/Berlin
# true => docker-compose seeds "Berlin Dental Clinic" on startup.
SEED_DEMO=false

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- ngrok (only for: docker compose --profile ngrok up) ---------------------
NGROK_AUTHTOKEN=
